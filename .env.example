# Copy to .env.local (gitignored) and fill in. Never commit real keys.
BOSON_API_KEY=bai-your-key-here
# DATABASE_URL is injected by `insta run -- npm run dev`; set it here only if you run without insta.
# DATABASE_URL=postgres://...
# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3100
